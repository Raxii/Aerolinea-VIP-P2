@model MoldeMVC_Core.Models.Compra
@{ ViewData["Title"] = "Detalle de Compras"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Compras</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Reserva ObjectId</dt><dd class="fw-semibold">@(Model.ReservaId.ToString())</dd></div><div class="col-md-6"><dt class="text-muted small">Fecha compra</dt><dd class="fw-semibold">@(Model.FechaCompra.ToString("dd/MM/yyyy HH:mm"))</dd></div><div class="col-md-6"><dt class="text-muted small">Importe</dt><dd class="fw-semibold">@(Model.Importe.ToString("N2"))</dd></div><div class="col-md-6"><dt class="text-muted small">Moneda</dt><dd class="fw-semibold">@(Model.Moneda)</dd></div><div class="col-md-6"><dt class="text-muted small">Estado</dt><dd class="fw-semibold">@(Model.Estado)</dd></div><div class="col-md-6"><dt class="text-muted small">Clave de idempotencia</dt><dd class="fw-semibold">@(Model.ClaveIdempotencia)</dd></div></dl><h2 class="h5 mt-4">Pagos</h2><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID SQL</th><th>Fecha</th><th>Importe</th><th>Estado</th><th>Método</th><th>Operación</th></tr></thead><tbody>@foreach (var p in Model.Pagos) { <tr><td>@p.IdSql</td><td>@p.FechaPago.ToString("dd/MM/yyyy")</td><td>@p.Importe.ToString("N2")</td><td>@p.Estado</td><td>@p.MetodoPago</td><td>@p.CodigoOperacion</td></tr> }</tbody></table></div><h2 class="h5 mt-4">Comprobantes</h2><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID SQL</th><th>Tipo</th><th>Número</th><th>Emisión</th><th>Estado</th></tr></thead><tbody>@foreach (var c in Model.Comprobantes) { <tr><td>@c.IdSql</td><td>@c.Tipo</td><td>@c.Numero</td><td>@c.FechaEmision.ToString("dd/MM/yyyy")</td><td>@c.Estado</td></tr> }</tbody></table></div><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
