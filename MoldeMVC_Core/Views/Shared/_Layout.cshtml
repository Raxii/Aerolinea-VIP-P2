
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Aerolínea VIP</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MoldeMVC_Core.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Aerolínea VIP
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <!-- INICIO -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Inicio
                                </a>
                            </li>

                            <!-- OPERACIÓN -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Operación
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Vuelos"
                                           asp-action="Index">
                                            Vuelos
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Rutas"
                                           asp-action="Index">
                                            Rutas
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Aeropuertos"
                                           asp-action="Index">
                                            Aeropuertos
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Aeronaves"
                                           asp-action="Index">
                                            Aeronaves
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Itinerarios"
                                           asp-action="Index">
                                            Itinerarios
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- COMERCIAL -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Comercial
                                </a>

                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Pasajeros"
                                           asp-action="Index">
                                            Pasajeros
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Reservas"
                                           asp-action="Index">
                                            Reservas
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Asignaciones"
                                           asp-action="Index">
                                            Asignaciones
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Compras"
                                           asp-action="Index">
                                            Compras
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <!-- CONFIGURACIÓN -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Configuración
                                </a>

                                <ul class="dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Catalogos"
                                           asp-action="Index">
                                            Catálogos
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="DatosEmisor"
                                           asp-action="Index">
                                            Datos del emisor
                                        </a>
                                    </li>

                                    <!-- GESTIÓN DE ROLES - MOD-11 -->
                                    @if (User.IsInRole("Superusuario") ||
                                         User.IsInRole("Administrador"))
                                    {
                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Roles"
                                               asp-action="Index">
                                                Gestión de roles
                                            </a>
                                        </li>

                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="Roles"
                                               asp-action="Usuarios">
                                                Gestión de usuarios
                                            </a>
                                        </li>
                                    }

                                </ul>
                            </li>
                        }
                        else
                        {
                            <!-- USUARIO NO AUTENTICADO -->
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-area="Identity"
                                   asp-page="/Account/Login">
                                    No autorizado. Iniciar sesión
                                </a>
                            </li>
                        }

                    </ul>

                    <!-- LOGIN Y LOGOUT -->
                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- PIE DE PÁGINA -->
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Aerolínea VIP - ASP.NET Core MVC y MongoDB
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
