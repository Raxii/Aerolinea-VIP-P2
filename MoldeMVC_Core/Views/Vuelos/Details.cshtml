@model MoldeMVC_Core.Models.Vuelo
@{ ViewData["Title"] = "Detalle de Vuelos"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Vuelos</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Fecha operación</dt><dd class="fw-semibold">@(Model.FechaOperacion.ToString("dd/MM/yyyy"))</dd></div><div class="col-md-6"><dt class="text-muted small">Estado</dt><dd class="fw-semibold">@(Model.Estado)</dd></div><div class="col-md-6"><dt class="text-muted small">Ruta ObjectId</dt><dd class="fw-semibold">@(Model.Ruta.RutaId.ToString())</dd></div><div class="col-md-6"><dt class="text-muted small">Tarifa referencial</dt><dd class="fw-semibold">@(Model.Ruta.TarifaReferencial.ToString("N2"))</dd></div><div class="col-md-6"><dt class="text-muted small">Origen</dt><dd class="fw-semibold">@(Model.Ruta.Origen.CodigoIATA + " - " + Model.Ruta.Origen.Nombre + " (" + Model.Ruta.Origen.Localidad + ")")</dd></div><div class="col-md-6"><dt class="text-muted small">Destino</dt><dd class="fw-semibold">@(Model.Ruta.Destino.CodigoIATA + " - " + Model.Ruta.Destino.Nombre + " (" + Model.Ruta.Destino.Localidad + ")")</dd></div><div class="col-md-6"><dt class="text-muted small">Frecuencia SQL</dt><dd class="fw-semibold">@(Model.Frecuencia.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Día semana</dt><dd class="fw-semibold">@(Model.Frecuencia.DiaSemana)</dd></div><div class="col-md-6"><dt class="text-muted small">Hora salida</dt><dd class="fw-semibold">@(Model.Frecuencia.HoraSalida)</dd></div><div class="col-md-6"><dt class="text-muted small">Hora llegada</dt><dd class="fw-semibold">@(Model.Frecuencia.HoraLlegada)</dd></div><div class="col-md-6"><dt class="text-muted small">Aeronave</dt><dd class="fw-semibold">@(Model.Aeronave == null ? "Sin asignar" : Model.Aeronave.Matricula + " - " + Model.Aeronave.Modelo)</dd></div></dl><div class="mt-3"><h2 class="h5">Datos de ruta y frecuencia</h2><p><strong>Ruta ObjectId:</strong> <code>@Model.Ruta.RutaId</code></p><p><strong>Frecuencia:</strong> @Model.Frecuencia.DiaSemana · @Model.Frecuencia.HoraSalida - @Model.Frecuencia.HoraLlegada</p></div><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
