@model MoldeMVC_Core.Models.Vuelo
@{ ViewData["Title"] = "Editar Vuelos"; }
<div class="container py-4"><div class="mb-3"><h1 class="h3 mb-1">Editar Vuelos</h1><p class="text-muted mb-0">Complete los campos y guarde los cambios.</p></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Edit" method="post"><input type="hidden" name="id" value="@Model.Id.ToString()" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="IdSql" class="form-label">ID SQL</label><input asp-for="IdSql" type="number" class="form-control" /><span asp-validation-for="IdSql" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="FechaOperacion" class="form-label">Fecha de operación</label><input asp-for="FechaOperacion" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="FechaOperacion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Estado" class="form-label">Estado</label><input asp-for="Estado" class="form-control" /><span asp-validation-for="Estado" class="text-danger"></span></div>
<div class="col-md-6"><label class="form-label">Ruta ObjectId</label><input name="rutaId" value="@ViewBag.RutaId" class="form-control" placeholder="ObjectId de MongoDB (24 caracteres)" /><div class="form-text">Use el ObjectId del documento relacionado.</div><span class="text-danger">@Html.ValidationMessage("rutaId")</span></div>
<div class="col-md-6"><label asp-for="Ruta.TarifaReferencial" class="form-label">Tarifa referencial</label><input asp-for="Ruta.TarifaReferencial" type="number" step="any" class="form-control" /><span asp-validation-for="Ruta.TarifaReferencial" class="text-danger"></span></div>
<div class="col-md-6"><label class="form-label">Origen - ObjectId aeropuerto</label><input name="origenAeropuertoId" value="@ViewBag.OrigenId" class="form-control" placeholder="ObjectId de MongoDB (24 caracteres)" /><div class="form-text">Use el ObjectId del documento relacionado.</div><span class="text-danger">@Html.ValidationMessage("origenAeropuertoId")</span></div>
<div class="col-md-6"><label asp-for="Ruta.Origen.CodigoIATA" class="form-label">Origen - código IATA</label><input asp-for="Ruta.Origen.CodigoIATA" class="form-control" /><span asp-validation-for="Ruta.Origen.CodigoIATA" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Ruta.Origen.Nombre" class="form-label">Origen - nombre</label><input asp-for="Ruta.Origen.Nombre" class="form-control" /><span asp-validation-for="Ruta.Origen.Nombre" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Ruta.Origen.Localidad" class="form-label">Origen - localidad</label><input asp-for="Ruta.Origen.Localidad" class="form-control" /><span asp-validation-for="Ruta.Origen.Localidad" class="text-danger"></span></div>
<div class="col-md-6"><label class="form-label">Destino - ObjectId aeropuerto</label><input name="destinoAeropuertoId" value="@ViewBag.DestinoId" class="form-control" placeholder="ObjectId de MongoDB (24 caracteres)" /><div class="form-text">Use el ObjectId del documento relacionado.</div><span class="text-danger">@Html.ValidationMessage("destinoAeropuertoId")</span></div>
<div class="col-md-6"><label asp-for="Ruta.Destino.CodigoIATA" class="form-label">Destino - código IATA</label><input asp-for="Ruta.Destino.CodigoIATA" class="form-control" /><span asp-validation-for="Ruta.Destino.CodigoIATA" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Ruta.Destino.Nombre" class="form-label">Destino - nombre</label><input asp-for="Ruta.Destino.Nombre" class="form-control" /><span asp-validation-for="Ruta.Destino.Nombre" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Ruta.Destino.Localidad" class="form-label">Destino - localidad</label><input asp-for="Ruta.Destino.Localidad" class="form-control" /><span asp-validation-for="Ruta.Destino.Localidad" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Frecuencia.IdSql" class="form-label">Frecuencia - ID SQL</label><input asp-for="Frecuencia.IdSql" type="number" class="form-control" /><span asp-validation-for="Frecuencia.IdSql" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Frecuencia.DiaSemana" class="form-label">Frecuencia - día semana (1-7)</label><input asp-for="Frecuencia.DiaSemana" type="number" class="form-control" /><span asp-validation-for="Frecuencia.DiaSemana" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Frecuencia.HoraSalida" class="form-label">Hora salida (HH:mm:ss)</label><input asp-for="Frecuencia.HoraSalida" class="form-control" /><span asp-validation-for="Frecuencia.HoraSalida" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Frecuencia.HoraLlegada" class="form-label">Hora llegada (HH:mm:ss)</label><input asp-for="Frecuencia.HoraLlegada" class="form-control" /><span asp-validation-for="Frecuencia.HoraLlegada" class="text-danger"></span></div>
<div class="col-md-6"><label class="form-label">Aeronave ObjectId (opcional)</label><input name="aeronaveId" value="@ViewBag.AeronaveId" class="form-control" placeholder="ObjectId de MongoDB (24 caracteres)" /><div class="form-text">Use el ObjectId del documento relacionado.</div><span class="text-danger">@Html.ValidationMessage("aeronaveId")</span></div>
<div class="col-md-6"><label asp-for="Aeronave.Matricula" class="form-label">Aeronave - matrícula</label><input asp-for="Aeronave.Matricula" type="text" class="form-control" /><span asp-validation-for="Aeronave.Matricula" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Aeronave.Modelo" class="form-label">Aeronave - modelo</label><input asp-for="Aeronave.Modelo" type="text" class="form-control" /><span asp-validation-for="Aeronave.Modelo" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Aeronave.Fabricante" class="form-label">Aeronave - fabricante</label><input asp-for="Aeronave.Fabricante" type="text" class="form-control" /><span asp-validation-for="Aeronave.Fabricante" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Aeronave.CapacidadAsientos" class="form-label">Aeronave - capacidad</label><input asp-for="Aeronave.CapacidadAsientos" type="number" class="form-control" /><span asp-validation-for="Aeronave.CapacidadAsientos" class="text-danger"></span></div></div>
<div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">Guardar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
