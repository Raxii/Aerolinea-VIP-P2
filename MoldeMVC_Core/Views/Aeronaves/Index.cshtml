@model IEnumerable<MoldeMVC_Core.Models.Aeronave>
@{
    ViewData["Title"] = "Aeronaves";
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div><h1 class="h3 mb-1">Aeronaves</h1><p class="text-muted mb-0">Administración de registros de MongoDB · colección <code>aeronaves</code></p></div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i> Nuevo registro</a>
    </div>
    @if (TempData["Mensaje"] != null) { <div class="alert alert-success alert-dismissible fade show">@TempData["Mensaje"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 mb-3">
                <div class="col-md-6"><input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar en aeronaves..." /></div>
                <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Buscar</button></div>
                <div class="col-auto"><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
            </form>
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark"><tr><th>ID SQL</th><th>Matrícula</th><th>Estado</th><th>Fabricante</th><th>Modelo</th><th>Asientos</th><th class="text-end">Acciones</th></tr></thead>
                    <tbody>
                    @if (Model != null && Model.Any()) {
                        foreach (var item in Model) {
                            <tr><td>@(item.IdSql)</td><td>@(item.Matricula)</td><td>@(item.Estado)</td><td>@(item.Modelo.Fabricante)</td><td>@(item.Modelo.Nombre)</td><td>@(item.Asientos.Count)</td><td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id.ToString()" class="btn btn-sm btn-outline-info">Ver</a>
                                <a asp-action="Edit" asp-route-id="@item.Id.ToString()" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id.ToString()" class="btn btn-sm btn-outline-danger">Eliminar</a>
                            </td></tr>
                        }
                    } else { <tr><td colspan="7" class="text-center text-muted py-4">No existen registros para mostrar.</td></tr> }
                    </tbody>
                </table>
            </div>
            <div class="small text-muted mt-3">Registros mostrados: @(Model?.Count() ?? 0)</div>
        </div>
    </div>
</div>
