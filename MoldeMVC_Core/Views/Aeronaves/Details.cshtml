@model MoldeMVC_Core.Models.Aeronave

@{
    ViewData["Title"] = "Detalles de aeronave";
    bool puedeAdministrar = User.IsInRole("Superusuario") || User.IsInRole("Administrador");
}

<div class="container mt-4">
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-info text-white"><h4 class="mb-0">Detalles de la aeronave</h4></div>
        <div class="card-body p-3">
            <dl class="row">
                <dt class="col-sm-4">Código de registro</dt><dd class="col-sm-8">@Model.IdSql</dd>
                <dt class="col-sm-4">Matrícula</dt><dd class="col-sm-8">@Model.Matricula</dd>
                <dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@Model.Estado</dd>
                <dt class="col-sm-4">ID SQL del modelo</dt><dd class="col-sm-8">@Model.Modelo?.IdSql</dd>
                <dt class="col-sm-4">Fabricante</dt><dd class="col-sm-8">@Model.Modelo?.Fabricante</dd>
                <dt class="col-sm-4">Modelo</dt><dd class="col-sm-8">@Model.Modelo?.Nombre</dd>
                <dt class="col-sm-4">Capacidad de asientos</dt><dd class="col-sm-8">@Model.Modelo?.CapacidadAsientos</dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header"><h5 class="mb-0">Asientos (@(Model.Asientos?.Count ?? 0))</h5></div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead class="table-dark">
                        <tr><th>Número</th><th>Código</th><th>Fila</th><th>Lado</th><th>Ubicación</th></tr>
                    </thead>
                    <tbody>
                        @if (Model.Asientos != null && Model.Asientos.Count > 0)
                        {
                            @foreach (var asiento in Model.Asientos)
                            {
                                <tr>
                                    <td>@asiento.NumeroAsiento</td>
                                    <td>@asiento.Codigo</td>
                                    <td>@asiento.Fila</td>
                                    <td>@asiento.Lado</td>
                                    <td>@asiento.Ubicacion</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted">No hay asientos registrados.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2">
                @if (puedeAdministrar)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-warning">Editar</a>
                }
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
            </div>
        </div>
    </div>
</div>
