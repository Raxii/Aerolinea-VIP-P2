@model MoldeMVC_Core.Models.DatosEmisor
@{ ViewData["Title"] = "Nuevo Datos del emisor"; }
<div class="container py-4"><div class="mb-3"><h1 class="h3 mb-1">Nuevo Datos del emisor</h1><p class="text-muted mb-0">Complete los campos y guarde los cambios.</p></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Create" method="post">
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="IdSql" class="form-label">ID SQL</label><input asp-for="IdSql" type="number" class="form-control" /><span asp-validation-for="IdSql" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="NombreComercial" class="form-label">Nombre comercial</label><input asp-for="NombreComercial" class="form-control" /><span asp-validation-for="NombreComercial" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Identificacion" class="form-label">Identificación</label><input asp-for="Identificacion" class="form-control" /><span asp-validation-for="Identificacion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Direccion" class="form-label">Dirección</label><input asp-for="Direccion" class="form-control" /><span asp-validation-for="Direccion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Telefono" class="form-label">Teléfono</label><input asp-for="Telefono" type="text" class="form-control" /><span asp-validation-for="Telefono" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Correo" class="form-label">Correo</label><input asp-for="Correo" type="email" class="form-control" /><span asp-validation-for="Correo" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="LeyendaComprobante" class="form-label">Leyenda del comprobante</label><input asp-for="LeyendaComprobante" class="form-control" /><span asp-validation-for="LeyendaComprobante" class="text-danger"></span></div></div>
<div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">Guardar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
