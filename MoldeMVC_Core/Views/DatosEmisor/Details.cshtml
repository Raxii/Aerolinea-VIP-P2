@model MoldeMVC_Core.Models.DatosEmisor
@{ ViewData["Title"] = "Detalle de Datos del emisor"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Datos del emisor</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Nombre comercial</dt><dd class="fw-semibold">@(Model.NombreComercial)</dd></div><div class="col-md-6"><dt class="text-muted small">Identificación</dt><dd class="fw-semibold">@(Model.Identificacion)</dd></div><div class="col-md-6"><dt class="text-muted small">Dirección</dt><dd class="fw-semibold">@(Model.Direccion)</dd></div><div class="col-md-6"><dt class="text-muted small">Teléfono</dt><dd class="fw-semibold">@(Model.Telefono ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Correo</dt><dd class="fw-semibold">@(Model.Correo ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Leyenda</dt><dd class="fw-semibold">@(Model.LeyendaComprobante)</dd></div></dl><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
