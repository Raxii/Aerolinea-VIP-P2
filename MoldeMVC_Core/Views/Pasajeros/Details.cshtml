@model MoldeMVC_Core.Models.Pasajero
@{ ViewData["Title"] = "Detalle de Pasajeros"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Pasajeros</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Tipo de documento</dt><dd class="fw-semibold">@(Model.TipoDocumento.Codigo + " - " + Model.TipoDocumento.Descripcion)</dd></div><div class="col-md-6"><dt class="text-muted small">Número de documento</dt><dd class="fw-semibold">@(Model.NumeroDocumento)</dd></div><div class="col-md-6"><dt class="text-muted small">Nombres</dt><dd class="fw-semibold">@(Model.Nombres)</dd></div><div class="col-md-6"><dt class="text-muted small">Apellidos</dt><dd class="fw-semibold">@(Model.Apellidos)</dd></div><div class="col-md-6"><dt class="text-muted small">Fecha nacimiento</dt><dd class="fw-semibold">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Correo</dt><dd class="fw-semibold">@(Model.Correo ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Teléfono</dt><dd class="fw-semibold">@(Model.Telefono ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Fecha registro</dt><dd class="fw-semibold">@(Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm"))</dd></div></dl><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
