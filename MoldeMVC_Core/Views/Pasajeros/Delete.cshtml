@model MoldeMVC_Core.Models.Pasajero
@{ ViewData["Title"] = "Eliminar Pasajeros"; }
<div class="container py-4"><div class="card border-danger shadow-sm"><div class="card-header bg-danger text-white"><h1 class="h5 mb-0">Confirmar eliminación</h1></div><div class="card-body"><p>¿Está seguro de eliminar este registro?</p><h2 class="h5">@(Model.Nombres + " " + Model.Apellidos)</h2><p class="text-muted small">Esta acción no se puede deshacer.</p><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.Id.ToString()" /><button type="submit" class="btn btn-danger">Sí, eliminar</button><a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancelar</a></form></div></div></div>
