@model MoldeMVC_Core.Models.Catalogo
@{ ViewData["Title"] = "Detalle de Catálogos"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Catálogos</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">Tipo</dt><dd class="fw-semibold">@(Model.Tipo)</dd></div><div class="col-md-6"><dt class="text-muted small">Código</dt><dd class="fw-semibold">@(Model.Codigo)</dd></div><div class="col-md-6"><dt class="text-muted small">Descripción</dt><dd class="fw-semibold">@(Model.Descripcion)</dd></div><div class="col-md-6"><dt class="text-muted small">Ocupa inventario</dt><dd class="fw-semibold">@(Model.OcupaInventario?.ToString() ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Estado visual</dt><dd class="fw-semibold">@(Model.EstadoVisual ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Activo</dt><dd class="fw-semibold">@(Model.Activo?.ToString() ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Activa</dt><dd class="fw-semibold">@(Model.Activa?.ToString() ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Longitud número</dt><dd class="fw-semibold">@(Model.LongitudNumero?.ToString() ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Longitud código seguridad</dt><dd class="fw-semibold">@(Model.LongitudCodigoSeguridad?.ToString() ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Prefijos referencia</dt><dd class="fw-semibold">@(Model.PrefijosReferencia ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Ruta logo</dt><dd class="fw-semibold">@(Model.RutaLogo ?? "-")</dd></div></dl><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
