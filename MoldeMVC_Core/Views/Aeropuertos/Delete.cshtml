@model MoldeMVC_Core.Models.Aeropuerto

@{
    ViewData["Title"] = "Eliminar aeropuerto";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Eliminar Aeropuerto</h4>
        </div>

        <div class="card-body p-3">

            <div class="alert alert-warning">
                ¿Está seguro de que desea eliminar este aeropuerto?
                Esta operación no se puede deshacer.
            </div>

            <dl class="row">

                <dt class="col-sm-4">
                    Código de registro
                </dt>
                <dd class="col-sm-8">
                    @Model.IdSql
                </dd>

                <dt class="col-sm-4">
                    Código IATA
                </dt>
                <dd class="col-sm-8">
                    @Model.CodigoIATA
                </dd>

                <dt class="col-sm-4">
                    Nombre
                </dt>
                <dd class="col-sm-8">
                    @Model.Nombre
                </dd>

                <dt class="col-sm-4">
                    Localidad
                </dt>
                <dd class="col-sm-8">
                    @Model.Localidad
                </dd>

                <dt class="col-sm-4">
                    Estado
                </dt>
                <dd class="col-sm-8">
                    @(Model.Activo ? "Activo" : "Inactivo")
                </dd>

            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id.ToString()"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-danger">
                        Confirmar eliminación
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancelar
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>
