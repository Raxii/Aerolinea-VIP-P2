@model IEnumerable<MoldeMVC_Core.Models.Aeropuerto>
@using System.Linq

@{
    ViewData["Title"] = "Aeropuertos";
    string buscar = ViewBag.Buscar as string ?? "";

    bool puedeAdministrar =
        User.IsInRole("Superusuario") ||
        User.IsInRole("Administrador");
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Aeropuertos</h2>

        @if (puedeAdministrar)
        {
            <a asp-action="Create" class="btn btn-primary">
                + Nuevo aeropuerto
            </a>
        }
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-info">
            @TempData["Mensaje"]
        </div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body p-3">

            <form asp-action="Index" method="get" class="row g-2">

                <div class="col-md-9">
                    <input type="text"
                           name="buscar"
                           value="@buscar"
                           class="form-control"
                           placeholder="Buscar por código IATA, nombre, localidad o ID SQL" />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Buscar
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Limpiar
                    </a>
                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-3">

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID SQL</th>
                            <th>Código IATA</th>
                            <th>Nombre</th>
                            <th>Localidad</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.IdSql</td>
                                    <td>
                                        <strong>@item.CodigoIATA</strong>
                                    </td>
                                    <td>@item.Nombre</td>
                                    <td>@item.Localidad</td>

                                    <td>
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id.ToString()"
                                               class="btn btn-info btn-sm text-white">
                                                Detalles
                                            </a>

                                            @if (puedeAdministrar)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id.ToString()"
                                                   class="btn btn-warning btn-sm">
                                                    Editar
                                                </a>

                                                <a asp-action="Delete"
                                                   asp-route-id="@item.Id.ToString()"
                                                   class="btn btn-danger btn-sm">
                                                    Eliminar
                                                </a>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    No se encontraron aeropuertos.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
