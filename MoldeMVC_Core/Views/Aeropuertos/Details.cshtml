@model MoldeMVC_Core.Models.Aeropuerto

@{
    ViewData["Title"] = "Detalles del aeropuerto";

    bool puedeAdministrar =
        User.IsInRole("Superusuario") ||
        User.IsInRole("Administrador");
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Detalles del Aeropuerto</h4>
        </div>

        <div class="card-body p-3">

            <dl class="row">

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.IdSql)
                </dt>
                <dd class="col-sm-8">
                    @Model.IdSql
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.CodigoIATA)
                </dt>
                <dd class="col-sm-8">
                    @Model.CodigoIATA
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Nombre)
                </dt>
                <dd class="col-sm-8">
                    @Model.Nombre
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Localidad)
                </dt>
                <dd class="col-sm-8">
                    @Model.Localidad
                </dd>

                <dt class="col-sm-4">
                    @Html.DisplayNameFor(model => model.Activo)
                </dt>
                <dd class="col-sm-8">
                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactivo</span>
                    }
                </dd>

            </dl>

            <div class="d-flex gap-2">

                @if (puedeAdministrar)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id.ToString()"
                       class="btn btn-warning">
                        Editar
                    </a>
                }

                <a asp-action="Index" class="btn btn-secondary">
                    Volver al listado
                </a>

            </div>

        </div>
    </div>

</div>
