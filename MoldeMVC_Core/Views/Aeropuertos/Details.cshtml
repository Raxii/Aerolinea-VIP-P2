@model MoldeMVC_Core.Models.Aeropuerto
@{ ViewData["Title"] = "Detalle de Aeropuertos"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Aeropuertos</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Código IATA</dt><dd class="fw-semibold">@(Model.CodigoIATA)</dd></div><div class="col-md-6"><dt class="text-muted small">Nombre</dt><dd class="fw-semibold">@(Model.Nombre)</dd></div><div class="col-md-6"><dt class="text-muted small">Localidad</dt><dd class="fw-semibold">@(Model.Localidad)</dd></div><div class="col-md-6"><dt class="text-muted small">Activo</dt><dd class="fw-semibold">@(Model.Activo ? "Sí" : "No")</dd></div></dl><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
