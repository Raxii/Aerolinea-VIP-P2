@model MoldeMVC_Core.Models.Aeropuerto
@{ ViewData["Title"] = "Editar Aeropuertos"; }
<div class="container py-4"><div class="mb-3"><h1 class="h3 mb-1">Editar Aeropuertos</h1><p class="text-muted mb-0">Complete los campos y guarde los cambios.</p></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4"><form asp-action="Edit" method="post"><input type="hidden" name="id" value="@Model.Id.ToString()" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="IdSql" class="form-label">ID SQL</label><input asp-for="IdSql" type="number" class="form-control" /><span asp-validation-for="IdSql" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="CodigoIATA" class="form-label">Código IATA</label><input asp-for="CodigoIATA" class="form-control" /><span asp-validation-for="CodigoIATA" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Nombre" class="form-label">Nombre</label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Localidad" class="form-label">Localidad</label><input asp-for="Localidad" class="form-control" /><span asp-validation-for="Localidad" class="text-danger"></span></div>
<div class="col-md-6"><div class="form-check mt-4"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label">Activo</label></div></div></div>
<div class="d-flex gap-2 mt-4"><button type="submit" class="btn btn-primary">Guardar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</form></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
