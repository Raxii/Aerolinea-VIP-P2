@model MoldeMVC_Core.Models.Reserva
@{ ViewData["Title"] = "Detalle de Reservas"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Reservas</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Código reserva</dt><dd class="fw-semibold">@(Model.CodigoReserva ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Usuario ID</dt><dd class="fw-semibold">@(Model.UsuarioId)</dd></div><div class="col-md-6"><dt class="text-muted small">Fecha creación</dt><dd class="fw-semibold">@(Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm"))</dd></div><div class="col-md-6"><dt class="text-muted small">Fecha expiración</dt><dd class="fw-semibold">@(Model.FechaExpiracion?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd></div><div class="col-md-6"><dt class="text-muted small">Estado</dt><dd class="fw-semibold">@(Model.Estado)</dd></div></dl><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
