@model MoldeMVC_Core.Models.Asignacion
@{ ViewData["Title"] = "Detalle de Asignaciones"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Asignaciones</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Reserva ObjectId</dt><dd class="fw-semibold">@(Model.ReservaId.ToString())</dd></div><div class="col-md-6"><dt class="text-muted small">Pasajero ObjectId</dt><dd class="fw-semibold">@(Model.PasajeroId.ToString())</dd></div><div class="col-md-6"><dt class="text-muted small">Vuelo ObjectId</dt><dd class="fw-semibold">@(Model.VueloId.ToString())</dd></div><div class="col-md-6"><dt class="text-muted small">Número asiento</dt><dd class="fw-semibold">@(Model.NumeroAsiento)</dd></div><div class="col-md-6"><dt class="text-muted small">Importe tramo</dt><dd class="fw-semibold">@(Model.ImporteTramo.ToString("N2"))</dd></div><div class="col-md-6"><dt class="text-muted small">Estado</dt><dd class="fw-semibold">@(Model.Estado)</dd></div><div class="col-md-6"><dt class="text-muted small">Fecha asignación</dt><dd class="fw-semibold">@(Model.FechaAsignacion.ToString("dd/MM/yyyy HH:mm"))</dd></div></dl><h2 class="h5 mt-4">Check-in</h2>@if (Model.CheckIn == null) { <p class="text-muted">Sin información de check-in.</p> } else { <dl class="row"><dt class="col-sm-3">ID SQL</dt><dd class="col-sm-9">@Model.CheckIn.IdSql</dd><dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Model.CheckIn.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-sm-3">Estado</dt><dd class="col-sm-9">@Model.CheckIn.Estado</dd></dl> }<div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
