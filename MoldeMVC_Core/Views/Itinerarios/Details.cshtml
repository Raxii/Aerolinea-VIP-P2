@model MoldeMVC_Core.Models.Itinerario
@{ ViewData["Title"] = "Detalle de Itinerarios"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Itinerarios</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Referencia</dt><dd class="fw-semibold">@(Model.Referencia)</dd></div><div class="col-md-6"><dt class="text-muted small">Nombre</dt><dd class="fw-semibold">@(Model.Nombre)</dd></div><div class="col-md-6"><dt class="text-muted small">Estado</dt><dd class="fw-semibold">@(Model.Estado)</dd></div></dl><h2 class="h5 mt-4">Tramos</h2><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID SQL</th><th>Orden</th><th>Vuelo ObjectId</th></tr></thead><tbody>@foreach (var t in Model.Tramos) { <tr><td>@t.IdSql</td><td>@t.Orden</td><td><code>@t.VueloId</code></td></tr> }</tbody></table></div><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
