@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>
@{
    ViewData["Title"] = "Gestión de roles";
    bool esSuper = User.IsInRole("Superusuario");
    var baseRoles = new[] { "Superusuario", "Administrador", "Counter", "Pasajero" };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div><h1 class="h3">Gestión de roles</h1><p class="text-muted mb-0">Roles de ASP.NET Core Identity</p></div>
    <div class="d-flex gap-2">
        <a asp-action="Usuarios" class="btn btn-outline-primary">Usuarios y asignaciones</a>
        @if (esSuper) { <a asp-action="Create" class="btn btn-primary">Crear rol</a> }
    </div>
</div>
@if (TempData["Mensaje"] != null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="card shadow-sm"><div class="card-body p-3">
<table class="table table-hover align-middle mb-0">
    <thead><tr><th>Nombre</th><th>Tipo</th><th class="text-end">Acciones</th></tr></thead>
    <tbody>
    @foreach (var rol in Model)
    {
        bool inicial = baseRoles.Contains(rol.Name, StringComparer.OrdinalIgnoreCase);
        <tr>
            <td>@rol.Name</td>
            <td><span class="badge @(inicial ? "text-bg-secondary" : "text-bg-info")">@(inicial ? "Rol inicial" : "Rol adicional")</span></td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@rol.Id" class="btn btn-sm btn-outline-primary">Detalles</a>
                @if (esSuper && !inicial)
                {
                    <a asp-action="Edit" asp-route-id="@rol.Id" class="btn btn-sm btn-outline-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@rol.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div></div>
