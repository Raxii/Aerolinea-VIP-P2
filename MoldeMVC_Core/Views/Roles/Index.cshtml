@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Gestión de Roles";

    var rolesProtegidos = new[]
    {
        "Superusuario",
        "Administrador",
        "Counter",
        "Pasajero"
    };

    bool esSuperusuario = User.IsInRole("Superusuario");
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h2 class="fw-bold">Gestión de Roles</h2>
        <p class="text-muted">
            Administra los perfiles de acceso de Aerolínea VIP
        </p>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Mensaje"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mb-3">

        <a asp-action="Usuarios"
           class="btn btn-outline-primary rounded-pill px-4">
            Usuarios y roles
        </a>

        @if (esSuperusuario)
        {
            <a asp-action="Create"
               class="btn btn-success rounded-pill px-4 shadow-sm">
                + Crear Rol
            </a>
        }

    </div>

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3" style="width:60%">
                                ✦ Nombre del Rol
                            </th>
                            <th class="text-center py-3">
                                ⚙ Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            bool protegido = rolesProtegidos.Contains(
                                item.Name ?? "",
                                StringComparer.OrdinalIgnoreCase);

                            <tr>

                                <td class="ps-4 fw-medium text-secondary">
                                    @item.Name
                                </td>

                                <td class="text-center">

                                    @if (protegido)
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-2">
                                            Rol del sistema
                                        </span>
                                    }
                                    else if (esSuperusuario)
                                    {
                                        <div class="d-inline-flex gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                                Editar
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Está seguro de eliminar este rol?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                    Eliminar
                                                </button>

                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Solo lectura
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
