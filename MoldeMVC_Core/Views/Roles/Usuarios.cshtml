@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>
@{
    ViewData["Title"] = "Usuarios y roles";
    var asignaciones = ViewBag.RolesUsuarios as Dictionary<string, string>
        ?? new Dictionary<string, string>();
    bool esSuper = User.IsInRole("Superusuario");
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3">Usuarios y roles</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Volver a roles</a>
</div>
@if (TempData["Mensaje"] != null) { <div class="alert alert-success">@TempData["Mensaje"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="card shadow-sm"><div class="card-body p-3">
<table class="table table-hover align-middle">
    <thead><tr><th>Usuario</th><th>Correo</th><th>Roles</th><th class="text-end">Acción</th></tr></thead>
    <tbody>
    @foreach (var usuario in Model)
    {
        asignaciones.TryGetValue(usuario.Id, out var lista);
        bool elevado = (lista ?? "").Split(", ").Any(r => r == "Superusuario" || r == "Administrador");
        <tr>
            <td>@usuario.UserName</td>
            <td>@usuario.Email</td>
            <td>@(string.IsNullOrWhiteSpace(lista) ? "Sin rol" : lista)</td>
            <td class="text-end">
                @if (esSuper || !elevado)
                {
                    <a asp-action="Asignar" asp-route-id="@usuario.Id" class="btn btn-sm btn-primary">Gestionar roles</a>
                }
                else
                {
                    <span class="text-muted small">Restringido</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div></div>
