@model Microsoft.AspNetCore.Identity.IdentityRole
@{ ViewData["Title"] = "Crear rol"; }
<h1 class="h3 mb-3">Crear rol adicional</h1>
<div class="card shadow-sm"><div class="card-body p-4">
<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label for="nombre" class="form-label">Nombre del rol</label>
        <input id="nombre" name="nombre" class="form-control" maxlength="50" required value="@ViewBag.Nombre" />
    </div>
    <button type="submit" class="btn btn-primary">Crear</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
</form>
</div></div>
