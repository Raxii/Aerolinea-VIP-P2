@model MoldeMVC_Core.Models.Ruta
@{ ViewData["Title"] = "Detalle de Rutas"; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-3"><div><h1 class="h3 mb-1">Detalle de Rutas</h1><p class="text-muted mb-0">Información del documento seleccionado.</p></div><span class="badge bg-secondary">MongoDB</span></div>
<div class="card border-0 shadow-sm"><div class="card-body"><dl class="row"><div class="col-md-6"><dt class="text-muted small">ID SQL</dt><dd class="fw-semibold">@(Model.IdSql)</dd></div><div class="col-md-6"><dt class="text-muted small">Origen</dt><dd class="fw-semibold">@(Model.Origen.CodigoIATA + " - " + Model.Origen.Nombre + " (" + Model.Origen.Localidad + ")")</dd></div><div class="col-md-6"><dt class="text-muted small">Destino</dt><dd class="fw-semibold">@(Model.Destino.CodigoIATA + " - " + Model.Destino.Nombre + " (" + Model.Destino.Localidad + ")")</dd></div><div class="col-md-6"><dt class="text-muted small">Tarifa referencial</dt><dd class="fw-semibold">@(Model.TarifaReferencial.ToString("N2"))</dd></div><div class="col-md-6"><dt class="text-muted small">Activa</dt><dd class="fw-semibold">@(Model.Activa ? "Sí" : "No")</dd></div></dl><h2 class="h5 mt-4">Frecuencias</h2><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID SQL</th><th>Día</th><th>Salida</th><th>Llegada</th><th>Activa</th></tr></thead><tbody>@foreach (var f in Model.Frecuencias) { <tr><td>@f.IdSql</td><td>@f.DiaSemana</td><td>@f.HoraSalida</td><td>@f.HoraLlegada</td><td>@(f.Activa ? "Sí" : "No")</td></tr> }</tbody></table></div><div class="d-flex gap-2 mt-4"><a asp-action="Edit" asp-route-id="@Model.Id.ToString()" class="btn btn-primary">Editar</a><a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a></div></div></div></div>
